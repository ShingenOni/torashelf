// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// These are stored as TEXT/String and enforced at the application layer
// rather than as native Postgres enums, matching how the app already reads
// and writes them — switching to real enums is a separate, later change.

model Game {
  id          String   @id @default(cuid())
  title       String
  publisher   String
  releaseDate DateTime?

  revisions GameRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

// One row per regional print / cart revision of a Game. Region-free status,
// language support, and trust level are all properties of a specific print,
// not the title as a whole — that's the core distinction this app tracks.
model GameRevision {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  regionOfCart String // "US" | "EU" | "JP" | "ASIA" | "OTHER"
  regionFree   String // "REGION_FREE" | "REGION_LOCKED" | "UNKNOWN"

  languages              String // JSON-encoded string[], e.g. ["EN","JA","FR"]
  languageLockedToRegion Boolean // true = language tied to cart print, false = follows console OS language

  // "FULL_CARTRIDGE" | "GAME_KEY_CARD" | "DIGITAL_ONLY" — whether the cart
  // actually holds the game data, or is just a license key requiring a full
  // download (and Nintendo's servers to stay up). Core to the app's whole
  // point: this affects whether buying physical gets you what you'd expect.
  cartridgeFormat String @default("FULL_CARTRIDGE")

  // "SWITCH_1" | "SWITCH_2" | "SWITCH_2_EDITION" — which console generation
  // this print targets. Independent of cartridgeFormat: a Switch 2 title can
  // still ship as a full cartridge, so cartridgeFormat alone can't stand in
  // for platform. SWITCH_2_EDITION is a distinct upgrade SKU of a Switch 1
  // title (e.g. Pokémon Legends: Z-A's Switch 2 Edition), not just a
  // regional print — represented as its own revision on the same Game so it
  // can be compared side-by-side with the original, the same way regional
  // prints already are. Every pre-existing revision defaults to SWITCH_1,
  // since the catalog was entirely Switch 1-sourced before this field
  // existed; ordinary Switch 1 titles need no extra tag for Switch 2's
  // backward compatibility, since Nintendo guarantees that automatically.
  platform String @default("SWITCH_1")

  dataSource      String // "SCRAPED" | "COMMUNITY_VERIFIED" | "UNVERIFIED_SUBMISSION"
  sourceCitation  String?
  notes           String? // free-text nuance, e.g. "JA only on JP cart, EN print separate"

  // Who submitted this (null for scraped/seed entries) — needed to rate-limit
  // and attribute community submissions.
  submittedByUserId String?
  submittedByUser   User?   @relation("SubmittedRevisions", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  // Set once a revision accumulates enough open spam/abuse reports (see
  // REPORT_HIDE_THRESHOLD) — hidden entries are filtered out of browse/detail
  // queries but not deleted, so a moderator can still review and reverse it.
  // Also set (for a different reason) once a correction proposal resolves —
  // see correctsRevisionId below.
  isHidden Boolean @default(false)

  // Set when this row is a proposed correction to an existing print rather
  // than a standalone print of its own. Routed through the same
  // confirm/dispute voting as everything else, but resolves by either
  // applying its fields onto the target and hiding itself (confirmed) or
  // just hiding itself (disputed) — it never becomes a second visible print
  // for the same release. Only one pending (non-hidden) correction per
  // target is allowed at a time, enforced at submission time rather than by
  // a DB constraint (not worth a partial index at this scale).
  correctsRevisionId String?
  correctsRevision    GameRevision?  @relation("RevisionCorrections", fields: [correctsRevisionId], references: [id], onDelete: Cascade)
  corrections         GameRevision[] @relation("RevisionCorrections")

  votes             SubmissionVote[]
  collectionEntries CollectionEntry[]
  reports           Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
  @@index([regionOfCart])
  @@index([regionFree])
  @@index([submittedByUserId])
  @@index([correctsRevisionId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? // required by the Auth.js Prisma adapter
  name          String?
  image         String? // required by the Auth.js Prisma adapter

  // Used by the personal collection dashboard to flag owned prints that are
  // region-locked away from home or don't carry a language the user reads.
  homeRegion         String @default("US") // "US" | "EU" | "JP" | "ASIA" | "OTHER"
  preferredLanguages String @default("[\"EN\"]") // JSON-encoded string[]

  // Permanent flag set once at signup (see EARLY_ADOPTER_THRESHOLD) — never
  // recomputed later, so it stays true for that user even as the site grows.
  isEarlyAdopter Boolean @default(false)
  signupNumber   Int? // this user's position in signup order, for display/debugging

  votes             SubmissionVote[]
  collectionEntries CollectionEntry[]
  submittedRevisions GameRevision[] @relation("SubmittedRevisions")
  reports            Report[]
  rateLimitEvents    RateLimitEvent[]

  createdAt DateTime @default(now())

  // NextAuth (Auth.js) relations for email magic-link auth
  accounts Account[]
  sessions Session[]
}

// Confirm/dispute vote on a GameRevision's accuracy, with optional evidence
// (e.g. a screenshot proving actual language content) for disputed entries.
model SubmissionVote {
  id             String       @id @default(cuid())
  gameRevisionId String
  gameRevision   GameRevision @relation(fields: [gameRevisionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  vote        String // "CONFIRM" | "DISPUTE"
  evidenceUrl String? // path to uploaded screenshot/photo, local disk for MVP

  createdAt DateTime @default(now())

  @@unique([gameRevisionId, userId])
  @@index([gameRevisionId])
}

// A user's personal library entry for a specific cart revision.
model CollectionEntry {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRevisionId String
  gameRevision   GameRevision @relation(fields: [gameRevisionId], references: [id], onDelete: Cascade)

  status String // "OWNED" | "WISHLIST" | "CONSIDERING_IMPORT"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameRevisionId])
  @@index([userId])
}

// A spam/abuse flag on a revision — separate from SubmissionVote, which is
// for genuine data disagreement (confirm/dispute), not bad-faith content.
model Report {
  id             String       @id @default(cuid())
  gameRevisionId String
  gameRevision   GameRevision @relation(fields: [gameRevisionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason  String // "SPAM" | "ABUSE" | "OTHER"
  details String?

  status String @default("OPEN") // "OPEN" | "REVIEWED" | "DISMISSED"

  createdAt DateTime @default(now())

  @@unique([gameRevisionId, userId])
  @@index([gameRevisionId])
}

// Generic action log backing rate limiting — one row per rate-limited action
// taken, queried by count-within-window rather than a rolling counter, so
// the window slides naturally with no separate reset/cron job needed.
model RateLimitEvent {
  id        String   @id @default(cuid())
  action    String // "SUBMIT_GAME" | "VOTE" | "REPORT"
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action, userId, createdAt])
  @@index([action, ipAddress, createdAt])
}

// --- NextAuth (Auth.js) required models for the Prisma adapter ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
